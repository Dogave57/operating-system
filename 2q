int getfilelist(struct file* pdir, struct fileinfo** pplist, unsigned int* plist_entries){
	if (!pplist||!plist_entries)
		return -1;
	struct epic_fshdr fsinfo = {0};
	if (epic_get_fsinfo(pdir->drive, &fsinfo)!=0)
		return -1;
	struct epic_file filemd = {0};
	if (pdir&&epic_getfileinfo(pdir->drive, pdir->file_cluster, pdir->file_offset, &filemd)!=0)
		return -1;
	unsigned int filesize = filemd.size;
	if (!pdir)
		filesize = fsinfo.files_inroot*sizeof(struct epic_file);
	unsigned int file_clusters = 1+((filesize-1)/4096);
	if (!pdir)
		file_clusters = fsinfo.last_cluster;
	unsigned int current_cluster = filemd.data;
	if(!pdir)
		current_cluster = 1;
	unsigned int file_entries = filesize/sizeof(struct epic_file);
	struct fileinfo* plist = (struct fileinfo*)kmalloc(sizeof(struct fileinfo)*file_entries+1);
	if (!plist)
		return -1;
	*pplist = plist;
	*plist_entries = file_entries;
	unsigned int file_entry = 0;
	for (unsigned int i = 0;i<file_clusters;i++){
		unsigned int next_cluster = 0;
		if (epic_readcluster(pdir->drive, current_cluster, &next_cluster)!=0)
			return -1;
		unsigned char clusterdata[4096] = {0};
		if (epic_read_clusterdata(pdir->drive, current_cluster, clusterdata)!=0)
			return -1;
		unsigned int cluster_entries = (sizeof(clusterdata)-sizeof(struct epic_clusterhdr))/sizeof(struct epic_file);
		struct epic_clusterhdr* pclusterhdr = (struct epic_clusterhdr*)clusterdata;
		struct epic_file* pfilelist = (struct epic_file*)(pclusterhdr+1);
		for (unsigned int s = 0;s<cluster_entries;s++){
		struct epic_file* pfile = pfilelist+s;
		if (!pfile->inuse)
			continue;
		printf("found %s in dir\n", pfile->filename);
		struct fileinfo* pentry = plist+s;
		strcpy(pentry->filename, pfile->filename);
		pentry->filesize = pfile->size;
		pentry->drive = pdir->drive;
		file_entry++;
		if (file_entry>=file_entries)
			return 0;
		}
		current_cluster = next_cluster;	
	}
	return 0;
}
int closefile(struct file* pfile){
	if (!pfile)
		return -1;
	kfree((void*)pfile);
	return 0;
}
struct highlow_64 drive_getsectors(unsigned int drive){
	struct highlow_64 sectors = {0};
	uint16_t drive_info[256] = {0};
	if (drive_getinfo(drive, drive_info)!=0){
		print("failed to get drive info\n");
		return sectors;
	}
	sectors.low = (uint32_t)(drive_info[61]<<16)|(uint32_t)drive_info[60];
	sectors.high = ((uint32_t)drive_info[122]<<16)|(uint32_t)drive_info[123];
	return sectors;
}
